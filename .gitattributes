# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

# Código y WSDL generados
core/src/main/java/xyz/keibit/bcu/wsdl/**  linguist-generated=true
core/src/main/resources/wsdl/** linguist-generated=true
